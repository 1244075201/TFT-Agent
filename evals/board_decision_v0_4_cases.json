    },
    {
      "id": "streak_002", "slice": "small_streak_context",
      "prompt": "我8级70血50金币，当前5连胜；棋盘：Ahri 2星（蓝霸符）；目标是5费卡，要不要继续搜？",
      "expected_state": {"streak.type": "win", "streak.length": 5, "level": 8, "target_cost": 5},
