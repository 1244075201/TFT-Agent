      "expected_state": {"level": 7, "hp": 35, "gold": 40, "board.0.name": "Ahri", "board.0.star_level": 2, "board.0.items.0": "蓝霸符", "bench.0.name": "Garen"},
      "expected_tools": [], "allowed_tools": [], "expected_status": "completed"
    },
    {
      "id": "board_002", "slice": "unit_quality",
      "prompt": "棋盘：Ahri 1星，Sett 2星；备战席：Ahri 1星、Garen 1星。只根据这些事实给出定性建议。",
      "expected_state": {"board.0.name": "Ahri", "board.1.star_level": 2, "bench.0.name": "Ahri"},
      "expected_tools": [], "allowed_tools": [], "expected_status": "completed"
