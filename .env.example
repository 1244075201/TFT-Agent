# Copy to .env for local development. Never commit real secrets.
DEEPSEEK_API_KEY=
TFT_AGENT_MODEL=deepseek-v4-flash
TFT_AGENT_VISION_MODEL=deepseek-v4-flash-vision-exp
TFT_AGENT_VISION_DETAIL=high
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Empty-database bootstrap/test override; the SQLite patch registry is runtime authority afterward.
TFT_AGENT_CURRENT_GAME_PATCH=18.1d
TFT_AGENT_CURRENT_SET_NAME=Enchanted Wilds
TFT_AGENT_CURRENT_SET_NUMBER=18
TFT_AGENT_ENTITY_FUZZY_THRESHOLD=0.9
TFT_AGENT_EMBEDDING_MODEL=intfloat/multilingual-e5-small
TFT_AGENT_EMBEDDING_DEVICE=cpu
TFT_AGENT_RETRIEVAL_THRESHOLD=0.78
TFT_AGENT_DATATFT_URL=https://www.datatft.com/comps/tier/
TFT_AGENT_DATATFT_SERVER=cn
TFT_AGENT_DATATFT_MIN_SYNC_HOURS=6
TFT_AGENT_DATATFT_STALE_HOURS=48
TFT_AGENT_DATATFT_REQUEST_INTERVAL_SECONDS=0.75
# Experimental and off by default. Do not publish without Riot confirmation.
TFT_AGENT_EXPERIMENTAL_LIVE_ENABLED=false
TFT_AGENT_THINKING_MODE=disabled

# General agent runtime configuration.
TFT_AGENT_LOG_LEVEL=INFO
TFT_AGENT_MAX_STEPS=8
TFT_AGENT_LLM_MAX_RETRIES=2
TFT_AGENT_DATABASE_PATH=data/tft.sqlite3

# Optional Brave Web Search API; without a key, answers explicitly fall back to local data.
# Search adapter documentation: https://api-dashboard.search.brave.com/api-reference/web/search/get
TFT_AGENT_KNOWLEDGE_WEB_ENABLED=true
TFT_AGENT_KNOWLEDGE_SEARCH_API_KEY=
TFT_AGENT_KNOWLEDGE_REFRESH_HOURS=24
# App-owned daily source snapshots; no background task is installed outside the app.
TFT_AGENT_DATA_REFRESH_ENABLED=true
TFT_AGENT_DATA_REFRESH_HOURS=24
# Optional official CN announcement URLs, used alongside the official index and search.
TFT_AGENT_SERVER_VERSION_URLS=[]
TFT_AGENT_KNOWLEDGE_WEB_TIMEOUT_SECONDS=8
# JSON array, exact domains or their subdomains. HTTPS articles only; robots.txt is respected.
TFT_AGENT_KNOWLEDGE_ALLOWED_DOMAINS=["teamfighttactics.leagueoflegends.com","lol.qq.com","datatft.com","lolchess.gg","tactics.tools","metatft.com","tftacademy.com"]
