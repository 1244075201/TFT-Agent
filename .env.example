# Copy to .env for local development. Never commit real secrets.
DEEPSEEK_API_KEY=
TFT_AGENT_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
TFT_AGENT_CURRENT_GAME_PATCH=18.1
TFT_AGENT_CURRENT_SET_NAME=Enchanted Wilds
TFT_AGENT_EMBEDDING_MODEL=intfloat/multilingual-e5-small
TFT_AGENT_EMBEDDING_DEVICE=cpu
TFT_AGENT_RETRIEVAL_THRESHOLD=0.78
TFT_AGENT_THINKING_MODE=disabled

# General agent runtime configuration.
TFT_AGENT_LOG_LEVEL=INFO
TFT_AGENT_MAX_STEPS=8
TFT_AGENT_LLM_MAX_RETRIES=2
TFT_AGENT_DATABASE_PATH=data/tft.sqlite3
